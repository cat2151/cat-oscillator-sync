{
  "name": "cat-oscillator-sync-cli",
  "version": "1.0.0",
  "description": "Mouse-controlled hard sync oscillator for Windows CLI",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsc && node dist/main.js",
    "diag:mouse": "tsc && node dist/diagnostics/test-mouse-capture.js",
    "diag:freq": "tsc && node dist/diagnostics/test-frequency-sweep.js",
    "diag:audio": "tsc && node dist/diagnostics/test-mouse-audio.js",
    "diag:main": "tsc && node dist/diagnostics/main-diagnostic.js"
  },
  "keywords": [
    "audio",
    "synthesizer",
    "oscillator",
    "hard-sync",
    "windows"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "naudiodon": "^2.3.6",
    "robotjs": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.22",
    "typescript": "^5.9.3"
  }
}
